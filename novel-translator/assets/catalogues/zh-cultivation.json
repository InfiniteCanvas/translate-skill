{
  "language": "zh",
  "name": "Chinese xianxia/xuanhuan terms",
  "terms": [
    {"source": "练气", "variants": ["練氣"], "translation": "Qi Condensation", "category": "level", "definition": "First major realm of cultivation."},
    {"source": "筑基", "variants": ["築基"], "translation": "Foundation Establishment", "alt_translations": ["Foundation Building"], "category": "level", "definition": "Second major realm in which the cultivator's foundation is rebuilt."},
    {"source": "金丹", "variants": [], "translation": "Golden Core", "alt_translations": ["Gold Core", "Golden Elixir"], "category": "level", "definition": "Realm in which cultivation condenses into a golden core in the dantian."},
    {"source": "元婴", "variants": ["元嬰"], "translation": "Nascent Soul", "category": "level", "definition": "Realm in which the golden core births a nascent soul that can survive the body's death."},
    {"source": "化神", "variants": [], "translation": "Spirit Transformation", "alt_translations": ["Deity Transformation", "Soul Formation"], "category": "level", "definition": "Realm in which the nascent soul transforms and merges with spirit."},
    {"source": "炼虚", "variants": ["煉虛"], "translation": "Void Refinement", "category": "level", "definition": "High realm in which the self is refined toward harmony with the void."},
    {"source": "合体", "variants": ["合體"], "translation": "Body Integration", "category": "level", "definition": "High realm uniting body and soul into one."},
    {"source": "大乘", "variants": [], "translation": "Mahayana", "category": "level", "definition": "Penultimate realm of most cultivation systems."},
    {"source": "渡劫", "variants": [], "translation": "Tribulation Crossing", "alt_translations": ["Tribulation Transcendence"], "category": "level", "definition": "Realm-crossing trial in which the cultivator must survive heavenly tribulation to ascend."},
    {"source": "结丹", "variants": ["結丹"], "translation": "Core Formation", "alt_translations": ["Golden Core Formation", "Golden Core stage", "forming a Golden Core"], "category": "level", "definition": "Realm in which the cultivator first condenses a golden core."},
    {"source": "圆满", "variants": ["圓滿"], "translation": "Perfection", "alt_translations": ["completion", "consummation"], "category": "state", "definition": "State of having perfected a realm to its utmost before advancing."},
    {"source": "真仙", "variants": [], "translation": "True Immortal", "alt_translations": [], "category": "level", "definition": "Immortal rank attained after ascending beyond the mortal realms."},
    {"source": "金仙", "variants": [], "translation": "Golden Immortal", "alt_translations": [], "category": "level", "definition": "High immortal rank standing above True Immortal."},
    {"source": "大罗金仙", "variants": ["大羅金仙"], "translation": "Daluo Golden Immortal", "alt_translations": ["Grand Daluo Golden Immortal"], "category": "level", "definition": "Supreme immortal rank at the apex of the Daluo tier."},
    {"source": "天仙", "variants": [], "translation": "Celestial Immortal", "alt_translations": [], "category": "level", "definition": "Immortal rank associated with the celestial heavens."},
    {"source": "地仙", "variants": [], "translation": "Earth Immortal", "alt_translations": [], "category": "level", "definition": "Immortal who remains bound to the mortal world."},
    {"source": "仙帝", "variants": [], "translation": "Immortal Emperor", "alt_translations": [], "category": "level", "definition": "Sovereign ruler among immortals; an apex rank."},
    {"source": "仙界", "variants": [], "translation": "Immortal Realm", "alt_translations": ["immortal world", "Realm of Immortals"], "category": "place", "definition": "The higher world where immortals dwell."},
    {"source": "神界", "variants": [], "translation": "God Realm", "alt_translations": ["Divine Realm", "divine world", "Realm of Gods"], "category": "place", "definition": "The world above the Immortal Realm where gods dwell."}
  ]
}
